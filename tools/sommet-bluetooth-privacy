#!/bin/bash
# Sommet: Bluetooth privacy on while a watch pairs, off again after.
# Run as root by tools/bt_privacy.py through pkexec - see that file and the README
# ("Linux: pairing a watch over Bluetooth"). $1 = the btmgmt to use.
# Prints ALREADY (privacy was on: nothing done) | ON | FAILED, then waits on stdin:
# a line, EOF (Sommet quit) or 30 minutes turns privacy off again, printing OFF.
set -u
B="$1"
case "$(basename "$B")" in btmgmt) ;; *) echo "not btmgmt: $B" >&2; exit 2 ;; esac
privacy() { timeout 10 "$B" info 2>/dev/null | grep -q 'current settings:.* privacy'; }
if privacy; then echo ALREADY; exit 0; fi
timeout 10 "$B" power off >/dev/null 2>&1
timeout 10 "$B" privacy on >/dev/null 2>&1
timeout 10 "$B" power on >/dev/null 2>&1
if privacy; then echo ON; else echo FAILED; fi
read -r -t 1800 _ || true
timeout 10 "$B" power off >/dev/null 2>&1
timeout 10 "$B" privacy off >/dev/null 2>&1
timeout 10 "$B" power on >/dev/null 2>&1
echo OFF
